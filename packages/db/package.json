{
  "name": "@my-better-t-app/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "bun run src/migrate.ts",
    "db:generate": "bun run src/migrate.ts",
    "db:studio": "echo 'TypeORM studio not configured'",
    "db:migrate": "bun run src/migrate.ts",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@my-better-t-app/env": "*",
    "dotenv": "^17.2.2",
    "pg": "^8.17.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@my-better-t-app/config": "*",
    "@types/pg": "^8.16.0",
    "typescript": "^5"
  }
}
